rules_version = '2';
// قواعد حماية مقرأة الفاتح (الإصدار الثاني)
// - المعلم: حساب بريد وكلمة مرور، وله مستند في مجموعة teachers بمعرّف حسابه (UID)
// - الطالب: حساب ينشئه المعلم من الموقع، ويدخل باختيار صفه واسمه وكتابة كلمة السر
//   لا يرى الطالب إلا بياناته وتسليماته، ولا تُحفظ كلمات السر إلا في مجموعة cards التي لا يقرؤها إلا المعلم
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }
    // الطالب صاحب السجل: حسابه هو المسجل في مستند الطالب
    function isStudent(pn) {
      return signedIn() && get(/databases/$(database)/documents/roster/$(pn)).data.get('uid', '') == request.auth.uid;
    }

    match /teachers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false; // تُضاف من لوحة Firebase فقط
    }
    // الصفوف وأسماء الطلاب مقروءة لشاشة الدخول بلا تسجيل (لا تحوي كلمات سر ولا درجات)
    match /classes/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // أسماء طلاب كل صف لشاشة الدخول (بلا بيانات سرية)
    match /directory/{classId} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // كلمات السر الأولية لطباعة البطاقات: للمعلم فقط
    match /cards/{pn} {
      allow read, write: if isTeacher();
    }
    match /tasks/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    // لوحة الشرف: أسماء المتصدرين ونقاطهم فقط
    match /leaderboard/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    // التنبيهات: يكتبها المعلم، ويقرؤها الطلاب في جرس الموقع
    match /notifs/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    // أجهزة الإشعارات: كل جهاز يسجّل رمزه باسم صاحبه. يقرؤها خادم الإشعارات (يتجاوز القواعد)
    match /pushTokens/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && (isTeacher() || isStudent(request.resource.data.studentId));
      allow delete: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // الإعلانات: يكتبها المعلم وينشرها خادم الإشعارات. الطالب يسجّل فقط أنه قرأ
    match /announcements/{aid} {
      allow read, write: if isTeacher();
      match /reads/{pn} {
        allow read: if isTeacher();
        allow create: if isStudent(pn);
      }
    }
    // ختمات الصفوف: ينشئها المعلم، والطالب يضيف آيات أتقنها فقط (لا يحذف ولا يغيّر غيرها)
    match /khatmas/{kid} {
      allow read: if signedIn();
      allow create, delete: if isTeacher();
      allow update: if isTeacher()
        || (signedIn() && resource.data.get('completedAt', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'completedAt'])
            && request.resource.data.done.keys().hasAll(resource.data.get('done', {}).keys()));
    }
    // التحديات الودّية بين زميلين من الصف نفسه: كل طرف يكتب نتيجته مرة واحدة فقط
    match /challenges/{cid} {
      allow read: if signedIn();
      allow create: if isStudent(request.resource.data.a.pn)
        && request.resource.data.pns == [request.resource.data.a.pn, request.resource.data.b.pn]
        && request.resource.data.a.pn != request.resource.data.b.pn
        && get(/databases/$(database)/documents/roster/$(request.resource.data.b.pn)).data.classId == get(/databases/$(database)/documents/roster/$(request.resource.data.a.pn)).data.classId
        && request.resource.data.ra == null && request.resource.data.rb == null;
      allow update: if isTeacher()
        || (isStudent(resource.data.a.pn) && resource.data.get('ra', null) == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ra']))
        || (isStudent(resource.data.b.pn) && resource.data.get('rb', null) == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rb', 'declined']));
      allow delete: if isTeacher();
    }
    // صور الإعلانات (مصغّرة، صورة واحدة لكل إعلان، أقل من ٧٠٠ KB): يكتبها المعلم ويقرؤها الطلاب
    match /annImages/{aid} {
      allow read: if signedIn();
      allow create, update: if isTeacher() && request.resource.data.b64 is string && request.resource.data.b64.size() < 700000;
      allow delete: if isTeacher();
    }
    // قائمة الأخطاء ودرجاتها (يضبطها المعلم)
    match /catalog/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    // نتائج الشهور المعلنة (الأوائل فقط، بلا درجات بقية الطلاب)
    match /results/{ym} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    // إعدادات المعلم (مثل وقت التذكير)، ويقرؤها الخادم
    match /settings/{id} {
      allow read, write: if isTeacher();
    }
    // عدّاد استهلاك خادم التحليل: يكتبه الخادم وحده (حساب الخدمة يتجاوز القواعد)، ويقرؤه المعلم
    match /usage/{id} {
      allow read: if isTeacher();
      allow write: if false;
    }
    match /model/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    match /roster/{pn} {
      allow get: if isTeacher() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow list, create, delete: if isTeacher();
      // الطالب يستطيع فقط تسجيل أنه غيّر كلمة سره
      allow update: if isTeacher()
        || (signedIn() && resource.data.get('uid', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pwChanged', 'pwChangedAt']));

      match /subs/{sid} {
        allow read: if isTeacher() || isStudent(pn);
        // محاولة واحدة لكل واجب: معرّف التسليم ثابت (t_رقم الواجب، أو r_رقم طلب الإعادة)،
        // فإن وُجد من قبل صار الحفظ تعديلاً، والتعديل ممنوع على الطالب
        allow create: if isStudent(pn)
          && request.resource.data.pn == pn
          && request.resource.data.teacher == null
          && (request.resource.data.get('taskId', null) == null
            || (request.resource.data.get('retakeId', null) == null && sid == 't_' + request.resource.data.taskId)
            || (request.resource.data.get('retakeId', null) != null && sid == 'r_' + request.resource.data.retakeId
                && exists(/databases/$(database)/documents/roster/$(pn)/retakes/$(request.resource.data.retakeId))));
        // الطالب يضيف نتيجة تحليل التجويد الآلي فقط، وقبل تقييم المعلم
        allow update: if isTeacher()
          || (isStudent(pn) && resource.data.get('teacher', null) == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ai']));
        allow delete: if isTeacher();

        match /audio/{aid} {
          allow read: if isTeacher() || isStudent(pn);
          allow create: if isStudent(pn) && request.resource.data.b64.size() < 1000000;
          allow update, delete: if isTeacher();
        }
      }
      // سجل النشاط اليومي للسلسلة (تاريخ وعدد فقط، بلا صوت): يكتبه الطالب لنفسه
      match /activity/{day} {
        allow read: if isTeacher() || isStudent(pn);
        allow create, update: if isStudent(pn)
          && request.resource.data.keys().hasOnly(['d', 'practice', 'tasks', 'sec', 'at'])
          && request.resource.data.d == day;
      }
      // طلبات إعادة التسميع: يكتبها المعلم، ويقرؤها الطالب
      match /retakes/{rid} {
        allow read: if isTeacher() || isStudent(pn);
        allow write: if isTeacher();
      }
      // «مصحفي»: خريطة الحفظ (أفضل دقة ويوم آخر إتقان لكل آية)، يكتبها الطالب لنفسه
      match /progress/{doc} {
        allow read: if isTeacher() || isStudent(pn);
        allow write: if isTeacher() || isStudent(pn);
      }
      // رأيك يهمنا: الطالب يرسل ملاحظته باسمه ويقرأ ملاحظاته ورد المعلم. المعلم يقرأ ويرد ويحذف
      match /feedback/{fid} {
        allow read: if isTeacher() || isStudent(pn);
        allow create: if isStudent(pn)
          && request.resource.data.keys().hasOnly(['pn', 'name', 'classId', 'className', 'kind', 'text', 'createdAt'])
          && request.resource.data.pn == pn
          && request.resource.data.kind in ['comment', 'complaint', 'suggest', 'note']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        // الطالب يسجّل فقط أنه قرأ رد المعلم
        allow update: if isTeacher()
          || (isStudent(pn) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replySeen']));
        allow delete: if isTeacher();
      }
      // تنبيهات خاصة بالطالب (مثل وصول درجته): لا يقرؤها غيره
      match /notifs/{nid} {
        allow read: if isTeacher() || isStudent(pn);
        allow write: if isTeacher();
      }
    }
    // استعلام المعلم عن كل الملاحظات
    match /{path=**}/feedback/{fid} {
      allow read: if isTeacher();
    }
    // استعلام المعلم عن كل التسليمات
    match /{path=**}/subs/{sid} {
      allow read: if isTeacher();
    }
    // بيانات النسخة القديمة: قراءة فقط للمعلم لأجل النقل
    match /students/{id} { allow read: if isTeacher(); allow write: if false; }
    match /assignments/{id} { allow read: if isTeacher(); allow write: if false; }
  }
}
